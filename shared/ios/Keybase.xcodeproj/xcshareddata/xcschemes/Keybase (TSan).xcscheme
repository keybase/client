<?xml version="1.0" encoding="UTF-8"?>
<!--
   Keybase with ThreadSanitizer on, for the mobile RPC bridge's reader-thread
   races. Shared (checked in) so nobody has to rebuild the Diagnostics tab by
   hand. Notes:

   - TSan and ASan cannot both be linked into one binary; use "Keybase (ASan)"
     for the memory pass, separately.
   - The Go framework is prebuilt and uninstrumented, so TSan cannot see the Go
     runtime's synchronization. tsan-suppressions.txt silences that; reports
     naming only C++/ObjC frames are the ones to trust.
   - GODEBUG=asyncpreemptoff=1 stops Go's SIGURG-based preemption, which both
     TSan and lldb otherwise trip over (it is the same flag that fixes the
     device debug-launch freeze).
   - halt_on_error + abort_on_error stop at the first report so lldb catches
     the SIGABRT with both racing stacks live. If an uninstrumented-Go false
     positive gets through the suppressions this will stop on it, so add the
     frame to tsan-suppressions.txt rather than turning halting back off.
   - Expect it to be slow: TSan costs roughly 5-15x runtime and ~5x memory.
-->
<Scheme
   LastUpgradeVersion = "1640"
   version = "1.3">
   <BuildAction
      parallelizeBuildables = "YES"
      buildImplicitDependencies = "YES">
      <BuildActionEntries>
         <BuildActionEntry
            buildForTesting = "YES"
            buildForRunning = "YES"
            buildForProfiling = "YES"
            buildForArchiving = "YES"
            buildForAnalyzing = "YES">
            <BuildableReference
               BuildableIdentifier = "primary"
               BlueprintIdentifier = "13B07F861A680F5B00A75B9A"
               BuildableName = "Keybase.app"
               BlueprintName = "Keybase"
               ReferencedContainer = "container:Keybase.xcodeproj">
            </BuildableReference>
         </BuildActionEntry>
      </BuildActionEntries>
   </BuildAction>
   <TestAction
      buildConfiguration = "Debug"
      selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB"
      selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB"
      shouldUseLaunchSchemeArgsEnv = "YES">
      <MacroExpansion>
         <BuildableReference
            BuildableIdentifier = "primary"
            BlueprintIdentifier = "13B07F861A680F5B00A75B9A"
            BuildableName = "Keybase.app"
            BlueprintName = "Keybase"
            ReferencedContainer = "container:Keybase.xcodeproj">
         </BuildableReference>
      </MacroExpansion>
      <Testables>
      </Testables>
   </TestAction>
   <LaunchAction
      buildConfiguration = "Debug"
      selectedDebuggerIdentifier = "Xcode.DebuggerFoundation.Debugger.LLDB"
      selectedLauncherIdentifier = "Xcode.DebuggerFoundation.Launcher.LLDB"
      launchStyle = "0"
      useCustomWorkingDirectory = "NO"
      ignoresPersistentStateOnLaunch = "NO"
      debugDocumentVersioning = "YES"
      debugServiceExtension = "internal"
      enableThreadSanitizer = "YES"
      enableUndefinedBehaviorSanitizer = "YES"
      allowLocationSimulation = "YES">
      <BuildableProductRunnable
         runnableDebuggingMode = "0">
         <BuildableReference
            BuildableIdentifier = "primary"
            BlueprintIdentifier = "13B07F861A680F5B00A75B9A"
            BuildableName = "Keybase.app"
            BlueprintName = "Keybase"
            ReferencedContainer = "container:Keybase.xcodeproj">
         </BuildableReference>
      </BuildableProductRunnable>
      <EnvironmentVariables>
         <EnvironmentVariable
            key = "TSAN_OPTIONS"
            value = "suppressions=$(SRCROOT)/tsan-suppressions.txt:second_deadlock_stack=1:history_size=7:halt_on_error=1:abort_on_error=1"
            isEnabled = "YES">
         </EnvironmentVariable>
         <EnvironmentVariable
            key = "UBSAN_OPTIONS"
            value = "print_stacktrace=1"
            isEnabled = "YES">
         </EnvironmentVariable>
         <EnvironmentVariable
            key = "GODEBUG"
            value = "asyncpreemptoff=1"
            isEnabled = "YES">
         </EnvironmentVariable>
         <EnvironmentVariable
            key = "OS_ACTIVITY_MODE"
            value = "disable"
            isEnabled = "NO">
         </EnvironmentVariable>
      </EnvironmentVariables>
   </LaunchAction>
   <ProfileAction
      buildConfiguration = "Release"
      shouldUseLaunchSchemeArgsEnv = "YES"
      savedToolIdentifier = ""
      useCustomWorkingDirectory = "NO"
      debugDocumentVersioning = "YES">
      <BuildableProductRunnable
         runnableDebuggingMode = "0">
         <BuildableReference
            BuildableIdentifier = "primary"
            BlueprintIdentifier = "13B07F861A680F5B00A75B9A"
            BuildableName = "Keybase.app"
            BlueprintName = "Keybase"
            ReferencedContainer = "container:Keybase.xcodeproj">
         </BuildableReference>
      </BuildableProductRunnable>
   </ProfileAction>
   <AnalyzeAction
      buildConfiguration = "Debug">
   </AnalyzeAction>
   <ArchiveAction
      buildConfiguration = "Release"
      revealArchiveInOrganizer = "YES">
   </ArchiveAction>
</Scheme>
