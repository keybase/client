// node tests/e2e/fixtures/corpus/make-corpus.mts
//
// Writes the files flows attach, drop and paste (see corpus.ts). The output is the same on every
// run: generated bytes come from fixed inputs, and the timestamps the macOS converters stamp into
// their outputs are zeroed. Only macOS built-ins (sips, afconvert, avconvert, ditto) and node.
import {execFileSync} from 'child_process'
import * as fs from 'fs'
import * as os from 'os'
import * as path from 'path'
import {fileURLToPath} from 'url'
import * as zlib from 'zlib'

const dir = path.dirname(fileURLToPath(import.meta.url))
const out = (name: string) => path.join(dir, name)
const fixturesDir = path.resolve(dir, '..')
const run = (cmd: string, args: ReadonlyArray<string>) => execFileSync(cmd, args, {stdio: ['ignore', 'ignore', 'inherit']})
// a fixed local mtime for the zip entry, which stores local time: the same bytes in every time zone
const fixedTime = new Date(2026, 0, 1)

const chunk = (type: string, data: Buffer) => {
  const len = Buffer.alloc(4)
  len.writeUInt32BE(data.length)
  const body = Buffer.concat([Buffer.from(type, 'latin1'), data])
  const crc = Buffer.alloc(4)
  crc.writeUInt32BE(zlib.crc32(body))
  return Buffer.concat([len, body, crc])
}

// An 8-bit RGB PNG; `pixel` gives each pixel's [r, g, b].
const png = (width: number, height: number, pixel: (x: number, y: number) => [number, number, number]) => {
  const ihdr = Buffer.alloc(13)
  ihdr.writeUInt32BE(width, 0)
  ihdr.writeUInt32BE(height, 4)
  ihdr[8] = 8
  ihdr[9] = 2
  const raw = Buffer.alloc((width * 3 + 1) * height)
  for (let y = 0; y < height; y++) {
    const row = y * (width * 3 + 1)
    for (let x = 0; x < width; x++) raw.set(pixel(x, y), row + 1 + x * 3)
  }
  return Buffer.concat([
    Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]),
    chunk('IHDR', ihdr),
    chunk('IDAT', zlib.deflateSync(raw, {level: 9})),
    chunk('IEND', Buffer.alloc(0)),
  ])
}

// 1s of a 440Hz tone, 8kHz mono 16-bit PCM
const wav = () => {
  const rate = 8000
  const b = Buffer.alloc(44 + rate * 2)
  b.write('RIFF', 0, 'latin1')
  b.writeUInt32LE(36 + rate * 2, 4)
  b.write('WAVEfmt ', 8, 'latin1')
  b.writeUInt32LE(16, 16)
  b.writeUInt16LE(1, 20)
  b.writeUInt16LE(1, 22)
  b.writeUInt32LE(rate, 24)
  b.writeUInt32LE(rate * 2, 28)
  b.writeUInt16LE(2, 32)
  b.writeUInt16LE(16, 34)
  b.write('data', 36, 'latin1')
  b.writeUInt32LE(rate * 2, 40)
  for (let i = 0; i < rate; i++) b.writeInt16LE(Math.round(8000 * Math.sin((2 * Math.PI * 440 * i) / rate)), 44 + i * 2)
  return b
}

// The classic 1x1 GIF89a: one white pixel, transparent.
const gif = Buffer.from('47494638396101000100800000ffffff00000021f90401000000002c00000000010001000002024401003b', 'hex')

// One page that says "e2e corpus", with the xref offsets computed.
const pdf = () => {
  const stream = 'BT /F1 24 Tf 72 720 Td (e2e corpus) Tj ET'
  const objects = [
    '<< /Type /Catalog /Pages 2 0 R >>',
    '<< /Type /Pages /Kids [3 0 R] /Count 1 >>',
    '<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 4 0 R /Resources << /Font << /F1 5 0 R >> >> >>',
    `<< /Length ${stream.length} >>\nstream\n${stream}\nendstream`,
    '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>',
  ]
  let body = '%PDF-1.4\n'
  const offsets: Array<number> = []
  objects.forEach((o, i) => {
    offsets.push(body.length)
    body += `${i + 1} 0 obj\n${o}\nendobj\n`
  })
  const xref = body.length
  body += `xref\n0 ${objects.length + 1}\n0000000000 65535 f \n`
  for (const o of offsets) body += `${String(o).padStart(10, '0')} 00000 n \n`
  body += `trailer\n<< /Size ${objects.length + 1} /Root 1 0 R >>\nstartxref\n${xref}\n%%EOF\n`
  return Buffer.from(body, 'latin1')
}

// mulberry32: the same bytes for the same seed
const randomBytes = (seed: number, n: number) => {
  let a = seed >>> 0
  const b = Buffer.alloc(n)
  for (let i = 0; i < n; i++) {
    a = (a + 0x6d2b79f5) >>> 0
    let t = a
    t = Math.imul(t ^ (t >>> 15), t | 1)
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61)
    b[i] = ((t ^ (t >>> 14)) >>> 0) & 0xff
  }
  return b
}
const BIN_SEED = 0x6b623265

// Zeroes the creation and modification times in an ISO media file's mvhd, tkhd and mdhd boxes,
// which avconvert and afconvert set to the time of the conversion.
const zeroMediaTimes = (file: string) => {
  const b = fs.readFileSync(file)
  const containers = new Set(['moov', 'trak', 'mdia'])
  const walk = (start: number, end: number) => {
    for (let at = start; at + 8 <= end; ) {
      let size = b.readUInt32BE(at)
      const type = b.subarray(at + 4, at + 8).toString('latin1')
      let header = 8
      if (size === 1) {
        size = Number(b.readBigUInt64BE(at + 8))
        header = 16
      } else if (size === 0) size = end - at
      if (size < header) throw new Error(`${file}: bad box ${type} at ${at}`)
      if (containers.has(type)) walk(at + header, at + size)
      else if (type === 'mvhd' || type === 'tkhd' || type === 'mdhd') {
        const version = b[at + header]
        b.fill(0, at + header + 4, at + header + 4 + (version === 1 ? 16 : 8))
      }
      at += size
    }
  }
  walk(0, b.length)
  fs.writeFileSync(file, b)
}

const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'kb-e2e-corpus-'))
try {
  const image = out('e2e-c.png')
  fs.writeFileSync(image, png(64, 48, (x, y) => [(x * 4) & 0xff, (y * 5) & 0xff, ((x + y) * 3) & 0xff]))
  fs.writeFileSync(out('e2e-c-large.png'), png(4000, 3000, (x, y) => [(x >> 7) * 8, (y >> 7) * 10, ((x >> 7) ^ (y >> 7)) * 8]))
  run('sips', ['-s', 'format', 'jpeg', image, '--out', out('e2e-c.jpg')])
  run('sips', ['-s', 'format', 'heic', image, '--out', out('e2e-c.heic')])
  fs.writeFileSync(out('e2e-c.gif'), gif)

  fs.copyFileSync(path.join(fixturesDir, 'e2e-video.mp4'), out('e2e-c.mp4'))
  fs.rmSync(out('e2e-c.mov'), {force: true})
  run('avconvert', ['--source', out('e2e-c.mp4'), '--preset', 'PresetPassthrough', '--output', out('e2e-c.mov')])
  zeroMediaTimes(out('e2e-c.mov'))

  const tone = path.join(tmp, 'tone.wav')
  fs.writeFileSync(tone, wav())
  run('afconvert', ['-f', 'm4af', '-d', 'aac', tone, out('e2e-c.m4a')])
  zeroMediaTimes(out('e2e-c.m4a'))

  fs.writeFileSync(out('e2e-c.pdf'), pdf())

  const text = out('e2e-c.txt')
  fs.writeFileSync(text, 'e2e corpus text file\n')
  fs.utimesSync(text, fixedTime, fixedTime)
  fs.rmSync(out('e2e-c.zip'), {force: true})
  run('ditto', ['-c', '-k', '--norsrc', '--noextattr', '--noqtn', '--noacl', text, out('e2e-c.zip')])

  fs.writeFileSync(out('e2e-c.bin'), randomBytes(BIN_SEED, 64 * 1024))
  fs.writeFileSync(out('e2e c ünïcode.txt'), 'e2e corpus file with spaces and accents in its name\n')
  fs.writeFileSync(out('e2e-c-empty.txt'), '')
} finally {
  fs.rmSync(tmp, {force: true, recursive: true})
}
