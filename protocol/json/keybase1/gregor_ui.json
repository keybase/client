{
  "protocol": "gregorUI",
  "imports": [
    {
      "path": "../gregor1",
      "type": "idl",
      "import_as": "gregor1"
    },
    {
      "path": "common.avdl",
      "type": "idl"
    }
  ],
  "types": [
    {
      "type": "enum",
      "name": "PushReason",
      "symbols": [
        "NONE_0",
        "RECONNECTED_1",
        "NEW_DATA_2"
      ]
    },
    {
      "type": "record",
      "name": "GregorUIPrefs",
      "fields": [
        {
          "type": {
            "type": "array",
            "items": "string"
          },
          "name": "pinnedConvs"
        },
        {
          "type": {
            "type": "map",
            "values": "int",
            "keys": "string"
          },
          "name": "explodingModes"
        },
        {
          "type": {
            "type": "array",
            "items": "string"
          },
          "name": "unreadableExplodingModes"
        },
        {
          "type": {
            "type": "array",
            "items": "string"
          },
          "name": "chosenChannelsTeamnames"
        },
        {
          "type": {
            "type": "map",
            "values": "string",
            "keys": "string"
          },
          "name": "blockButtonsAdders"
        },
        {
          "type": {
            "type": "map",
            "values": {
              "type": "array",
              "items": "string"
            },
            "keys": "string"
          },
          "name": "teamAccessRequests"
        },
        {
          "type": "boolean",
          "name": "allowAnimatedEmojis"
        }
      ]
    }
  ],
  "messages": {
    "pushState": {
      "request": [
        {
          "name": "state",
          "type": "gregor1.State"
        },
        {
          "name": "reason",
          "type": "PushReason"
        }
      ],
      "response": null,
      "oneway": true
    },
    "pushUIPrefs": {
      "request": [
        {
          "name": "prefs",
          "type": "GregorUIPrefs"
        },
        {
          "name": "uid",
          "type": "UID"
        }
      ],
      "response": null,
      "oneway": true
    },
    "pushOutOfBandMessages": {
      "request": [
        {
          "name": "oobm",
          "type": {
            "type": "array",
            "items": "gregor1.OutOfBandMessage"
          }
        }
      ],
      "response": null,
      "oneway": true
    }
  },
  "namespace": "keybase.1"
}